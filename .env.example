# ---------- 数据库 ----------
# 应用连接（读写）：Prisma 用。建表、存对话历史、存保存的查询都走它。
DATABASE_URL=""

# ⚠️ Agent 执行 SQL 专用连接 —— **必须是只读账号**。
# 这是安全模型的第一层（见 docs/ACCEPTANCE-W1.md 第 3 节）：
# 模型再怎么被诱导也改不了数据，因为这个账号没有那个权限。
# 不要图省事把它填成和 DATABASE_URL 一样 —— 那就等于把安全交给 prompt 自觉。
AGENT_DATABASE_URL=""

# ---------- LLM ----------
# DeepSeek（OpenAI 兼容）。它是推理模型，思考 token 照样计费，调用时要关掉。
LLM_API_KEY=""
LLM_BASE_URL="https://api.deepseek.com/v1"
LLM_MODEL="deepseek-flash"

# ---------- Embedding（预留，当前不使用）----------
# `search_schema` 最终用的是关键词 + IDF（src/lib/schema-search.ts），不是向量：
# 候选只有 21 篇文档，且查询与文档共用同一套术语，词频类方法更准也更能单测。
# 实测 recall@3 = 0.917，未触发「上向量」的兜底条件（门槛 0.85）。
# 这里留着是给后续扩容用的 —— 表数上到几百张时关键词会先失效。
# `schema_docs.embedding` 字段同理，暂为空。
EMBED_API_KEY=""
EMBED_BASE_URL="https://api.siliconflow.cn/v1"
EMBED_MODEL="BAAI/bge-m3"

# ---------- 本机网络（可选）----------
# 只有 Prisma CLI 连 Neon、或 GitHub 类海外请求才需要。
HTTPS_PROXY=""
